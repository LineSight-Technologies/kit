{
  "name": "@linesight/kit",
  "version": "0.1.0",
  "private": true,
  "description": "LineSight design kit: tokens, primitives, and screen patterns shared by every LineSight React app.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens/tokens.css",
    "./base.css": "./src/tokens/base.css",
    "./theme.v4.css": "./src/tokens/theme.v4.css",
    "./tailwind.preset": "./src/tokens/tailwind.preset.ts",
    "./catalog": "./src/catalog/index.ts"
  },
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "vite build --config playground/vite.config.ts",
    "preview": "vite preview --config playground/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && node scripts/lint-classes.mjs",
    "test": "vitest run",
    "test:visual": "playwright test",
    "docs": "node scripts/gen-kit-md.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run docs -- --check",
    "test:visual:docker": "docker run --rm -v \"$PWD\":/work -v linesight-kit-nm:/work/node_modules -w /work -e CI=1 mcr.microsoft.com/playwright:v1.56.0-noble sh -c \"npm ci --no-audit --no-fund >/dev/null && npx playwright test $*\"",
    "test:visual:update": "docker run --rm -v \"$PWD\":/work -v linesight-kit-nm:/work/node_modules -w /work -e CI=1 mcr.microsoft.com/playwright:v1.56.0-noble sh -c \"npm ci --no-audit --no-fund >/dev/null && npx playwright test --update-snapshots\""
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.546.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.46.0",
    "vite": "^6.3.6",
    "vitest": "^3.2.4"
  }
}
